<?xml version="1.0" encoding="utf-8"?>
<!--
  识别结果确认面板（底部弹出的玻璃片）。
  背景是透明的：真正的磨砂底由 dialog 的 design_bottom_sheet 容器画
  （MainActivity 里换成 bg_acrylic_sheet），这样圆角和阴影才对。
  这里如果自己刷白底，会盖掉那层磨砂，露出一个死白的方块。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- 拖拽条 -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/preview_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- 解析警告：日期对不上、只有周几、只看到时间等，都在这里说清楚 -->
        <LinearLayout
            android:id="@+id/boxWarnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_warn_chip"
            android:orientation="vertical"
            android:padding="13dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWarnTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_warn_title"
                android:textColor="@color/warn"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/warn"
                android:textSize="12.5sp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Input.NoOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/label_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="2"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="10月24日 周六"
                android:textColor="@color/brand_dark"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:strokeColor="#4D2563EB" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="15:30"
                android:textColor="@color/brand_dark"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:strokeColor="#4D2563EB" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbAllDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_all_day"
                android:textSize="13sp" />

            <!-- 结束时间：有明确结束时间就显示时刻，点开仍可选时长覆盖 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnd"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:text="@string/end_all_day"
                android:textColor="@color/brand_dark"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#4D2563EB" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Input.NoOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/label_location">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 分类。横向可滚动：五个中文标签在窄屏上放不下，
             硬挤会把"社团"压成两行（通知方式那排已经吃过一次这个亏）。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sheet_cat_label"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatStudy"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_study"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatWork"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_work"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatClub"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_club"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatLife"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_life"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatOther"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_other"
                    android:textSize="13sp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvCatHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cat_auto_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="11.5sp" />

        <!-- 这条日程自己的通知方式。
             "跟随设置"做成勾选框而不是第五个按钮：五个按钮挤一行会把"跟随设置"截成两行。
             勾上 = 没单独设置（存 -1），按钮组变灰；点任意一档就自动取消勾选。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStyleLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sheet_style_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbFollowStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="@string/style_name_default"
                android:textSize="12.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tgEventStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyleFull"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/remind_style_full"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyleBanner"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/remind_style_banner"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyleVibrate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/remind_style_vibrate"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyleSilent"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/remind_style_silent"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:insetLeft="0dp"
                android:insetRight="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvStyleDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_inset"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_cancel"
                android:textColor="@color/text_secondary"
                app:cornerRadius="14dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_btn_primary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/action_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
