<?xml version="1.0" encoding="utf-8"?>
<!--
  全屏提醒页。

  布局上只有一个原则：**一眼就知道是什么事、几点**。
  所以时间放在最上面且很大（一眼扫到），标题其次，地点再次。
  操作只有两个按钮，指头够得着的高度，不需要滑动。

  深色底而不是应用里的浅色磨砂：这一页多半是在锁屏、昏暗环境、或者用户
  正在别的事里被弹出来时看到的，浅色低对比度反而看不清。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_remind"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="72dp"
    android:paddingEnd="28dp"
    android:paddingBottom="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.24"
        android:text="@string/remind_tag"
        android:textColor="@color/remind_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvRemindTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="15:00"
        android:textColor="@color/remind_on"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/tvRemindDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/remind_muted"
        android:textSize="14sp"
        android:text="" />

    <TextView
        android:id="@+id/tvRemindTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/remind_on"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRemindLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/remind_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemindDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/remind_done"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemindSnooze"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="@string/remind_snooze"
        android:textColor="@color/remind_on"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:strokeColor="@color/remind_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemindOpen"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/remind_open"
        android:textColor="@color/remind_muted"
        android:textSize="14sp" />

</LinearLayout>
