<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面结构（亚克力版）：

    光斑背景（铺满）
      └ 磨砂头部条（贴顶，含状态栏占位）
          └ 输入卡（浮在头部下面）
              └ 待确认横幅
                  └ 列表

  和旧版的差别：旧版是一条深绿渐变带 + 白色卡片，看着像 2016 年的 App。
  现在整屏是一块被光照着的玻璃台面，所有面板都是半透明压在上面。

  状态栏：targetSdk 35 在 Android 15 上强制 edge-to-edge，
  代码把 statusBarSpace 的高度设为状态栏 inset，内容不会顶上去。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 光斑背景 -->
    <include
        layout="@layout/view_acrylic_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============ 磨砂头部 ============ -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_acrylic_header"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <View
                android:id="@+id/statusBarSpace"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/titleBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/header_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/search"
                    android:padding="10dp"
                    android:src="@drawable/ic_search" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/settings"
                    android:padding="9dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <!--
              检索条。和标题行二选一显示、占同一个位置 —— 弹到下面去会把
              输入卡和列表整体挤下去，一切换就跳一下。

              搜索时输入卡会一起收起来：两个都是输入框，同屏会抢焦点，
              而且键盘一弹，列表就只剩一条缝了。
            -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/Input.NoOutline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textSize="14.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/btnSearchCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:text="@string/search_close"
                    android:textColor="@color/brand_dark"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!--
              多选操作条。和标题行二选一显示，共用同一个位置 ——
              弹出一个新条会挤动下面的输入卡和列表，多选时列表会跳。
            -->
            <LinearLayout
                android:id="@+id/selectBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnSelectClose"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/select_close"
                    android:padding="9dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:id="@+id/tvSelectCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/select_none"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_select_bar_btn"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/select_all"
                    android:textColor="@color/brand_dark"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/btnSelectDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_select_bar_btn"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/select_bar_delete"
                    android:textColor="@color/warn"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 输入卡 ============ -->
        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_acrylic_card"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingTop="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="11dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilInput"
                style="@style/Input.NoOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_input_short">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="1"
                    android:textSize="14.5sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/action_clear"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnParse"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_primary"
                    android:drawableStart="@drawable/ic_notify"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="@string/action_parse"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 待确认横幅 ============ -->
        <LinearLayout
            android:id="@+id/bannerPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_warn_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="!"
                android:textColor="@color/warn"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/warn"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBannerDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:textColor="@color/warn"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 改期待确认横幅 ============
             和上面"待确认日程"是两件事：那边是新日程没把握，这边是已有日程的
             改期/换地点没认准。文案必须能一眼区分，否则用户不知道点哪个。 -->
        <LinearLayout
            android:id="@+id/bannerRevise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_warn_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textColor="@color/warn"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviseTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/warn"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviseDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:textColor="@color/warn"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 分类筛选 ============
             只影响列表显示，不写库。切走再回来保持当前筛选（进程内有效），
             重开应用回到"全部"—— 筛选是临时视角，不该变成持久设置。 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/filter_all"
                    android:textSize="12.5sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterStudy"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_study"
                    android:textSize="12.5sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterWork"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_work"
                    android:textSize="12.5sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterClub"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_club"
                    android:textSize="12.5sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterLife"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_life"
                    android:textSize="12.5sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterOther"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/cat_other"
                    android:textSize="12.5sp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!--
          检索结果条数。只在检索时出现 —— 平时它是一行废话。
          顺便把"当前还叠着分类筛选"这件事说出来，否则用户会以为搜漏了。
        -->
        <TextView
            android:id="@+id/tvSearchScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:text="找到 3 条" />

        <!-- ============ 列表 ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="28dp" />

            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingEnd="48dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_muted" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/empty_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/tvEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/empty_hint"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
